# Copy to .env and fill in your own values. Never commit a real .env.
# Supabase project (auth + database). Get these from your Supabase dashboard.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only. Bypasses row-level security — keep secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
# Used by drizzle-kit migrations (drizzle.config.ts). Optional for running the app.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Optional: CJ Dropshipping API key (per-user keys are stored in Settings instead).
CJ_API_KEY=
# Optional: eBay webhook destination ID for order/return notifications.
EBAY_NOTIFICATION_DESTINATION_ID=
# Optional: workspace-level AI provider for listing AI (per-user keys in
# Settings always win). Provider: deepseek | gemini | openai | custom.
# DeepSeek (cheapest): model deepseek-v4-flash, key from platform.deepseek.com.
# Gemini: model gemini-2.5-flash, key from aistudio.google.com.
# OpenAI: model gpt-4o-mini, key from platform.openai.com.
# Custom: set AI_BASE_URL to your OpenAI-compatible endpoint + AI_MODEL.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=
